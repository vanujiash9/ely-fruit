{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "images:guides": "node scripts/optimize-guide-images.mjs",
    "images:baskets": "node scripts/prepare-basket-images.mjs",
    "images:ingredients": "node scripts/extract-product-ingredients.mjs",
    "test:ingredients": "node --test scripts/extract-product-ingredients.test.mjs",
    "test:routing": "node --experimental-strip-types --test src/app/routing.test.ts",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
